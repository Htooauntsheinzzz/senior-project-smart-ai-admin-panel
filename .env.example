# Backend checkout, relative to this frontend compose.yaml.
BACKEND_PATH=../../backend/senior-project-smart-ai-web-backend

# Compose: same-origin API proxy. For npm run dev use http://localhost:8080.
VITE_API_BASE_URL=/

# Host port used by Docker Compose.
FRONTEND_PORT=3000

# Registration and "Sign in with Google" (spec-md/45). Needed here only for
# npm run dev: Docker Compose takes the three values from the backend .env
# (GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_HOSTED_DOMAIN, ADMIN_REGISTRATION_EMAIL_DOMAIN).
# The OAuth 2.0 Web client ID is not a secret. Empty: no real Google button.
VITE_GOOGLE_CLIENT_ID=
# The only email domain that may register.
VITE_ADMIN_EMAIL_DOMAIN=rsu.ac.th
# The Google Workspace domain offered by Google. Empty: the email domain.
VITE_GOOGLE_HOSTED_DOMAIN=
